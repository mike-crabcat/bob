# Bob instance environment — copy to <instance>/config/.env and fill in.
# Everything is optional except an LLM key: a fresh instance boots with
# defaults for the rest. See server/config.py for the full BOB_* surface.

# ── core ──────────────────────────────────────────────────────────────
# Port is set by compose (BOB_PORT), not here. Timezone for wall-clock
# tasks (dreams, wakeups, routines):
TZ=Australia/Perth

# ── LLM (required — pick one) ─────────────────────────────────────────
# Direct OpenAI:
BOB_OPENAI_API_KEY=sk-...
# Default model (server default is gpt-5.6-sol):
# BOB_OPENAI_DEFAULT_MODEL=gpt-5.6-sol
# OpenRouter (multi-provider) instead of/alongside OpenAI — the key is read
# from a file so the agent's bash tool can't see it:
#   echo "sk-or-..." > <instance>/config/openrouter_api_key && chmod 600
# BOB_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── agent harness ─────────────────────────────────────────────────────
# Enables the claude-CLI subagent harness (skills, bash tool). Auth:
#   docker compose run --rm bob claude login     # once, interactive OAuth
# or set an API key here instead:
# ANTHROPIC_API_KEY=sk-ant-...
BOB_HARNESS_ENABLED=true
BOB_HARNESS_SKILL_DEV_ENABLED=true

# ── skill keys (bundled skills that need them) ────────────────────────
# google-places:
# GOOGLE_PLACES_API_KEY=...
# videogen (Runware):
# RUNWARE_API_KEY=...
# openai-image uses OPENAI_API_KEY — usually the same key as BOB_OPENAI_API_KEY:
# OPENAI_API_KEY=sk-...

# ── browser ───────────────────────────────────────────────────────────
# compose already points BU_CDP_URL at the chrome sidecar; override only to
# reuse a host chrome instead (e.g. http://host.docker.internal:9223):
# BU_CDP_URL=http://chrome:9222

# ── channels (off unless the instance has its own number/endpoint) ────
# BOB_WHATSAPP_BRIDGE_ENABLED=false
# BOB_PHONE_ENABLED=false
# BOB_AGENTMAIL_API_KEY=...
